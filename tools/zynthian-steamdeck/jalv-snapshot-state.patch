+
+int
+jalv_load_snapshot(Jalv* jalv, const char* path)
+{
+  LilvState* state = lilv_state_new_from_file(jalv->world, &jalv->map, NULL, path);
+  if (!state) return 1;
+  const bool matches = lilv_node_equals(lilv_state_get_plugin_uri(state),
+                                        lilv_plugin_get_uri(jalv->plugin));
+  if (matches) {
+    const bool resume = jalv->play_state == JALV_RUNNING;
+    if (resume) {
+      jalv->play_state = JALV_PAUSE_REQUESTED;
+      zix_sem_wait(&jalv->paused);
+    }
+    jalv_apply_state(jalv, state);
+    jalv->request_update = true;
+    if (resume) jalv->play_state = JALV_RUNNING;
+  }
+  lilv_state_free(state);
+  return matches ? 0 : 1;
+}
